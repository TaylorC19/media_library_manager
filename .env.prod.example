# External database/Vercel runtime reference. Copy to `.env.prod` and adjust.
# Fresh bundled Compose installations use `mlm-setup init` to generate this file.

APP_ENV=production

# HTTP
PORT=8080
DEFAULT_LOCALE=en
PUBLIC_ORIGIN=https://your-domain.example
SIGNUP_ENABLED=false
ENSURE_INDEXES=false
# Set in deployment secrets: openssl rand -base64 32
PROVIDER_KEYS_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=__Host-mlm_session
# Session lifetime in hours (default in config: 336 = 14 days).
SESSION_TTL_HOURS=336
SESSION_COOKIE_SECURE=true

# MongoDB — set one of:
# - Atlas: mongodb+srv://...
# A replica set or Atlas cluster is required in production.
MONGODB_URI=
MONGODB_DATABASE=media_library

# Web database maintenance is disabled in production.
BACKUP_ENABLED=false
BACKUP_MAX_UPLOAD_BYTES=104857600

# Providers (optional; search/lookup degrade when unset)
TMDB_API_KEY=
RAWG_API_KEY=
DISCOGS_TOKEN=
MUSICBRAINZ_USER_AGENT=MediaLibraryManager/1.0 (https://example.com/contact)

# Provider reliability
PROVIDER_CACHE_VERSION=v1
PROVIDER_CACHE_SEARCH_TTL_MS=43200000
PROVIDER_CACHE_NEGATIVE_SEARCH_TTL_MS=900000
PROVIDER_CACHE_DETAIL_TTL_MS=604800000
PROVIDER_CACHE_NEGATIVE_DETAIL_TTL_MS=3600000
PROVIDER_CACHE_BARCODE_TTL_MS=604800000
PROVIDER_CACHE_NEGATIVE_BARCODE_TTL_MS=3600000
MUSICBRAINZ_MIN_INTERVAL_MS=1100
MUSICBRAINZ_RATE_LIMIT_COOLDOWN_MS=5000
MUSICBRAINZ_RETRYABLE_COOLDOWN_MS=2000

# Personal keys in production use encrypted MongoDB storage.
